# =============================================================================
# SentinelDrive - Variables de entorno
# Copia este archivo como .env y completa los valores.
# =============================================================================

# --- Seguridad ---
# Clave secreta para sesiones Flask. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Base de datos ---
# SQLite (default local):  sqlite:///sentinldrive.db?timeout=15
# PostgreSQL (Render):     postgresql://usuario:password@host:5432/dbname
DATABASE_URL=

# --- MQTT (TLS puerta 8883 por defecto) ---
MQTT_BROKER=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
# Topics por defecto (sobreescribir solo si es necesario)
# MQTT_TOPIC_GPS=flota/ecuador/buses/+/gps
# MQTT_TOPIC_EVENT=flota/ecuador/buses/+/event

# --- Flask ---
FLASK_DEBUG=false
# WTF_CSRF_ENABLED=true
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_LIFETIME_MINUTES=120

# --- Render (auto-detectado, no necesario configurar) ---
# RENDER=true
# RENDER_EXTERNAL_URL=
# SESSION_COOKIE_SECURE=true
# USE_PROXY_FIX=true
# PORT=5000

# --- Debug ---
# SQLALCHEMY_ECHO=false
